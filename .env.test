# Server
NODE_ENV=test
PORT=3000

# Database — must contain "_test" (enforced by tests/setup/testDb.ts)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/akewtutor_test

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30m

# Bcrypt — lower rounds in tests to keep the suite fast
BCRYPT_SALT_ROUNDS=4

# Client
CLIENT_URL=http://localhost:3000

# SMS provider (Geez SMS)
GEEZ_SMS_BASE_URL=https://api.geezsms.com/api/v1
GEEZ_SMS_API_KEY=test-geez-key

# Email provider (Brevo)
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=test-brevo-key
BREVO_SENDER_EMAIL=noreply@akewtutor.test

# Payments (Chapa)
CHAPA_API_KEY=test-chapa-key

# Object storage (Cloudflare R2) — test bucket, distinct from dev
CLOUDFLARE_R2_ACCESS_KEY=test-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=test-r2-secret-key
CLOUDFLARE_R2_BUCKET=akewtutor-recordings-test

# Seed admin (test-only identity, distinct from dev)
ADMIN_SEED_EMAIL=admin@akewtutor.test
ADMIN_SEED_PASSWORD=test-admin-password