// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  PARENT
  TUTOR
  ADMIN
}

enum NotifChannel {
  PUSH
  SMS
  EMAIL
}

enum VerificationCodePurpose {
  CONTACT_VERIFICATION
  PASSWORD_RESET
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// Canonical NotificationType values — Doc 04 §4.2.10 (L2 fix).
// No endpoint, job, or service may introduce a new value here without
// first adding it to that canonical table.
enum NotificationType {
  REGISTRATION_COMPLETE
  TUTOR_VERIFICATION_APPROVED
  TUTOR_VERIFICATION_REJECTED
  MATCH_FOUND
  MATCH_REJECTED
  BOOKING_CONFIRMED
  PAYMENT_RECEIVED
  CLASS_REMINDER
  CLASS_CANCELLED
  CLASS_RESCHEDULED
  MAKEUP_SCHEDULED
  ASSESSMENT_AVAILABLE
  WEEKLY_SUMMARY
  RECORDING_AVAILABLE
  MATERIAL_UPLOADED
  BADGE_EARNED
  LEADERBOARD_CHANGE
  EARNING_CREDITED
  PAYOUT_PROCESSED
  COMPLAINT_STATUS_UPDATE
  GUARDIAN_INVITE
  GUARDIAN_INVITE_RESEND
  COMPLAINT_RESOLVED
  PLATFORM_ANNOUNCEMENT
  NEW_MESSAGE
  ADMIN_REVIEW_REQUIRED
}

enum PolicyType {
  PRIVACY
  TERMS
  SAFETY
  REFUND
  RULES
}

// Doc 04 §4.2.1 — determines Grades 1–5 vs. 6–12 account-model routing
// (FR-AC-002/005). Default is PENDING_ACTIVATION; registerUser sets
// ACTIVE explicitly for the Grade 6–12 self-registration path.
enum StudentAccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  GUARDIAN_REQUIRED_HOLD
}

// Doc 04 §4.2.1/§4.2.3 — determines matching Path A/B vs. C.
enum TutoringFormat {
  ONE_TO_ONE
  ONE_TO_THREE
  ONE_TO_FIVE
}

// Doc 04 §4.2.1 — completes once the first linked student activates.
enum ParentOnboardingStatus {
  PENDING
  COMPLETE
}

// Doc 04 §4.2.1 — Admin-driven; PENDING until verified.
enum TutorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RelationshipType {
  MANDATORY_GUARDIAN
  OPTIONAL_GUARDIAN
}

enum RelationshipStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum UserAccountStatus {
  ACTIVE
  SUSPENDED
  RESTRICTED
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

model User {
  filedComplaints              ComplaintReport[] @relation("ComplaintReporter")
  resolvedComplaints           ComplaintReport[] @relation("ComplaintResolver")
  id                           String            @id @default(uuid())
  name                         String?
  role                         UserRole
  email                        String?           @unique
  phone                        String?           @unique
  passwordHash                 String
  emailVerifiedAt              DateTime?
  phoneVerifiedAt              DateTime?
  preferredNotificationChannel NotifChannel?
  termsAcceptedAt              DateTime
  failedLoginCount             Int               @default(0)
  status                       UserAccountStatus @default(ACTIVE)
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  // 1:1 profile rows — at most one populated per User, determined by
  // `role` at registration and never changed afterward (Doc 04 §4.2.1).
  // Admin has no profile row.
  studentProfile StudentProfile?
  parentProfile  ParentProfile?
  tutorProfile   TutorProfile?   @relation("TutorProfileUser")

  // TutorProfile.verifiedBy is a second FK to User, so that relation is
  // explicitly named; its inverse lives here.
  verifiedTutors TutorProfile[] @relation("TutorVerifiedBy")

  refreshTokens                 RefreshToken[]
  verificationCodes             VerificationCode[]
  notifications                 Notification[]
  publishedPolicies             PolicyDocument[]
  auditLogs                     AuditLog[]
  announcements                 Announcement[]
  revokedRelationships          ParentStudentRelationship[]
  cohorts                       Cohort[]
  earnings                      TutorEarning[]
  payouts                       Payout[]
  pricingConfigs                PricingConfig[]
  rescheduleRequestsRequested   RescheduleRequest[]
  recordingConsentsAcknowledged RecordingConsent[]          @relation("ConsentAcknowledgedBy")
  messageThreads                MessageThread[]
  messages                      Message[]
  challenges                    Challenge[]
  refundsApproved               Refund[]                    @relation("RefundApprovedBy")
  refundsRejected               Refund[]                    @relation("RefundRejectedBy")
  promotionsCreated             PromotionCode[]
}

model StudentProfile {
  id                         String               @id @default(uuid())
  userId                     String               @unique
  grade                      Int
  school                     String?
  profilePictureUrl          String?
  // Array of Subject IDs (FR-SP-008) — a Json array, per Doc 04 §4.2.1.
  subjectsOfInterest         Json                 @default("[]")
  academicLevel              String?
  learningGoals              String?
  // Hard filter, all formats (Section 5.2 callout). No schema default —
  // registerUser supplies a value; the column is required per Doc 04.
  preferredLanguage          String
  learningSchedulePreference Json?
  teachingStylePreference    String?
  budgetPreference           Decimal?
  formatPreference           TutoringFormat?
  accountStatus              StudentAccountStatus @default(PENDING_ACTIVATION)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianRelationships ParentStudentRelationship[]
  cohortMemberships     CohortMembership[]
  matchRequests         MatchRequest[]
  tutorExclusions       TutorExclusion[]
  formatSwitchRequests  FormatSwitchRequest[]
  xpledgerEntries       XPLedgerEntry[]
  studentBadges         StudentBadge[]
  streak                Streak?
  challengeProgresses   ChallengeProgress[]
  recordingConsents     RecordingConsent[]
}

model ParentProfile {
  id                String                 @id @default(uuid())
  userId            String                 @unique
  profilePictureUrl String?
  onboardingStatus  ParentOnboardingStatus @default(PENDING)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentRelationships ParentStudentRelationship[]
}

model TutorProfile {
  id                    String                  @id @default(uuid())
  userId                String                  @unique
  profilePictureUrl     String?
  bio                   String?
  experienceDescription String
  educationInstitution  String?
  degree                String?
  verificationStatus    TutorVerificationStatus @default(PENDING)
  verifiedAt            DateTime?
  verifiedById          String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  user       User  @relation("TutorProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  // onDelete is not Cascade here — deleting an Admin who once verified a
  // tutor must not delete the tutor's profile; it just nulls the pointer.
  verifiedBy User? @relation("TutorVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  subjectRankings   TutorSubjectRanking[]
  availabilitySlots AvailabilitySlot[]
  cohorts           Cohort[]
  tutorExclusions   TutorExclusion[]
  tutorBadges       TutorBadge[]
  recordingConsents RecordingConsent[]
  libraryMaterials  LibraryMaterial[]
  weeklyAssessments WeeklyAssessment[]
  tutorEarnings     TutorEarning[]
  payouts           Payout[]
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  familyId          String    @default(uuid())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdByIp       String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  // The only cascade exception in the schema (Doc 04 §4.4) — refresh
  // tokens are pure session artifacts with no standalone audit value
  // once their User is gone.
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces   RefreshToken[] @relation("RefreshTokenReplacement")

  @@index([userId, revokedAt])
  @@index([familyId])
}

// Backs verifyContact / resendVerification / requestPasswordReset /
// resetPassword. Only a hash of the code is stored, never the
// plaintext — the same pattern RefreshToken uses for tokenHash. A code
// is single-use (consumedAt) and time-limited (expiresAt); the service
// layer is responsible for treating any older unconsumed row of the
// same purpose as superseded when a new one is issued.
model VerificationCode {
  id         String                  @id @default(uuid())
  userId     String
  purpose    VerificationCodePurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  type      NotificationType
  payload   Json
  channel   NotifChannel
  status    NotificationStatus @default(QUEUED)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model PolicyDocument {
  id            String     @id @default(uuid())
  type          PolicyType
  content       String
  version       Int
  publishedById String
  publishedAt   DateTime   @default(now())
  createdAt     DateTime   @default(now())

  publishedBy User @relation(fields: [publishedById], references: [id])

  @@unique([type, version])
}

// Append-only record of money/PII/admin-trust-relevant actions, for
// compliance and dispute review (Doc 04 §4.2.10, working-context Rule 6).
// Written exclusively through `auditLog.service.record({ actor, action,
// target, timestamp })` — see `00-agent-rules.md` Rule 10 for the pinned
// call shape. Never updated or deleted; rows are insert-only.
model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  target    String
  timestamp DateTime @default(now())

  // No onDelete specified → Prisma's default `Restrict` for required
  // relations. Audit rows must survive their actor's deletion, so a
  // cascade here would be exactly wrong; a User cannot be hard-deleted
  // while audit rows reference them.
  actorUser User @relation(fields: [actor], references: [id])

  @@index([actor, timestamp])
  @@index([action, timestamp])
  @@index([target])
}

// Platform-wide announcement metadata — one row per announcement composed
// by an Admin (FR-AD-019, UC-89). Per-user delivery is fanned out through
// the Notification table (type PLATFORM_ANNOUNCEMENT); this model holds
// only the announcement record itself, which the admin listing reads back.
//
// SPEC GAP — flagged, not silently worked around: Doc 04 §4.2.9 defines
// no Announcement entity, but `tests/services/adminAnnouncement.service.test.ts`
// mocks `prisma.announcement.create/findMany/count` and asserts a
// persisted announcement whose `createdById` is echoed in the DTO. Per
// working-context Rule 1 (the test is the spec), the model is added here.
// Doc 04 should be updated to reflect it.
model Announcement {
  id            String     @id @default(uuid())
  title         String
  body          String
  audienceRoles UserRole[]
  createdById   String
  createdAt     DateTime   @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([createdAt])
}

model ParentStudentRelationship {
  id               String             @id @default(uuid())
  parentId         String
  studentId        String
  relationshipType RelationshipType
  status           RelationshipStatus @default(INVITED)
  permissions      Json               @default("{}")
  invitedAt        DateTime           @default(now())
  inviteExpiresAt  DateTime
  inviteToken      String             @unique
  activatedAt      DateTime?
  revokedAt        DateTime?
  revokedById      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  parent    ParentProfile  @relation(fields: [parentId], references: [id])
  student   StudentProfile @relation(fields: [studentId], references: [id])
  revokedBy User?          @relation(fields: [revokedById], references: [id])

  @@unique([parentId, studentId])
}

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutorRankings TutorSubjectRanking[]
  cohorts       Cohort[]
  matchRequests MatchRequest[]
}

model TutorSubjectRanking {
  id        String   @id @default(uuid())
  tutorId   String
  subjectId String
  rank      Int
  createdAt DateTime @default(now())

  tutor   TutorProfile @relation(fields: [tutorId], references: [id])
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([tutorId, rank])
  @@unique([tutorId, subjectId])
}

model AvailabilitySlot {
  id          String   @id @default(uuid())
  tutorId     String
  dayOfWeek   Int?
  startTime   DateTime
  endTime     DateTime
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())

  tutor TutorProfile @relation(fields: [tutorId], references: [id])
}

enum CohortStatus {
  FORMING
  PENDING_ADMIN_APPROVAL
  PENDING_PAYMENT
  ACTIVE
  ENDED
  CANCELLED
}

enum MembershipStatus {
  PENDING_PAYMENT
  ACTIVE
  ENDED
}

model Cohort {
  complaints                    ComplaintReport[]
  id                            String            @id @default(uuid())
  tutorId                       String
  subjectId                     String
  status                        CohortStatus      @default(FORMING)
  format                        TutoringFormat    @default(ONE_TO_ONE)
  schedule                      Json?
  targetGroupSize               Int?
  groupFormationWindowExpiresAt DateTime?
  sessionsPerWeek               Int?
  adminApprovedAt               DateTime?
  adminApprovedById             String?
  adminOverdueNotifiedAt        DateTime?
  studentDelayNotifiedAt        DateTime?
  endedAt                       DateTime?
  endedReason                   CohortEndReason?
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt

  tutor             TutorProfile       @relation(fields: [tutorId], references: [id])
  subject           Subject            @relation(fields: [subjectId], references: [id])
  memberships       CohortMembership[]
  adminApprovedBy   User?              @relation(fields: [adminApprovedById], references: [id])
  matchRequests     MatchRequest[]
  scheduledSessions ScheduledSession[]
  libraryMaterials  LibraryMaterial[]
  messageThread     MessageThread?
}

model CohortMembership {
  id                     String               @id @default(uuid())
  cohortId               String
  studentId              String
  status                 MembershipStatus     @default(PENDING_PAYMENT)
  billingCycleAnchorDate DateTime?
  joinedAt               DateTime             @default(now())
  endedAt                DateTime?
  endReason              MembershipEndReason?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  cohort            Cohort                @relation(fields: [cohortId], references: [id])
  student           StudentProfile        @relation(fields: [studentId], references: [id])
  formatSwitches    FormatSwitchRequest[]
  payments          Payment[]
  paymentPauses     PaymentPause[]
  weeklyAssessments WeeklyAssessment[]
}

// ---- PHASE 3: MATCHING & COHORTS ----

enum MatchPath {
  PATH_A
  PATH_B
  PATH_C
}

enum MatchRequestStatus {
  SEARCHING
  ZERO_MATCH_PENDING
  PENDING_ADMIN_ASSIGNMENT
  MATCHED
  CANCELLED
}

enum ExclusionReason {
  ADMIN_REJECTED
}

enum CohortEndReason {
  COMPLETED
  TUTOR_DROPOUT
  TUTOR_SUSPENDED
  FORMAT_SWITCH
  ADMIN_REJECTED
}

enum MembershipEndReason {
  COMPLETED
  FORMAT_SWITCH
  DROPPED_BY_ADMIN
}

model MatchRequest {
  id                String             @id @default(uuid())
  studentId         String
  subjectId         String
  tutorId           String?
  format            TutoringFormat
  path              MatchPath
  status            MatchRequestStatus @default(SEARCHING)
  zeroMatchSince    DateTime?
  resultingCohortId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  student              StudentProfile        @relation(fields: [studentId], references: [id])
  subject              Subject               @relation(fields: [subjectId], references: [id])
  resultingCohort      Cohort?               @relation(fields: [resultingCohortId], references: [id])
  formatSwitchRequests FormatSwitchRequest[]
}

model TutorExclusion {
  id        String          @id @default(uuid())
  studentId String
  tutorId   String
  reason    ExclusionReason @default(ADMIN_REJECTED)
  createdAt DateTime        @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id])
  tutor   TutorProfile   @relation(fields: [tutorId], references: [id])

  @@unique([studentId, tutorId])
}

model FormatSwitchRequest {
  id                String         @id @default(uuid())
  studentId         String
  fromMembershipId  String
  fromFormat        TutoringFormat
  toFormat          TutoringFormat
  newMatchRequestId String?
  refundId          String?
  requestedAt       DateTime       @default(now())
  completedAt       DateTime?

  student         StudentProfile   @relation(fields: [studentId], references: [id])
  fromMembership  CohortMembership @relation(fields: [fromMembershipId], references: [id])
  newMatchRequest MatchRequest?    @relation(fields: [newMatchRequestId], references: [id])
  refund          Refund?          @relation(fields: [refundId], references: [id])
}

model PricingConfig {
  id                     String         @id @default(uuid())
  format                 TutoringFormat
  pricePerStudentPerHour Decimal
  totalPerHour           Decimal
  platformSharePerHour   Decimal
  tutorSharePerHour      Decimal
  isActive               Boolean        @default(false)
  createdById            String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])
}

// ---- PHASE 4: CLASS DELIVERY & LIBRARY ----

enum SessionStatus {
  SCHEDULED
  COMPLETED
  MISSED
  RESCHEDULED
  PAYMENT_PAUSE_RESCHEDULED
  CANCELLED
}

enum RecordingUploadStatus {
  PENDING
  UPLOADED
  MISSING
  ESCALATED
}

enum RescheduleClassification {
  FREE_RESCHEDULE
  SAME_DAY_MISS
}

enum MissCause {
  TUTOR
  STUDENT
}

enum MissType {
  NO_SHOW
  LATE_CANCELLATION
  TECHNICAL_FAILURE
}

enum MaterialFileType {
  PDF
  NOTE
  BOOK
}

model ScheduledSession {
  complaints         ComplaintReport[]
  id                 String                @id @default(uuid())
  cohortId           String
  scheduledStart     DateTime
  scheduledEnd       DateTime
  jitsiLinkUrl       String?
  jitsiLinkSentAt    DateTime?
  status             SessionStatus         @default(SCHEDULED)
  isMakeup           Boolean               @default(false)
  makeupForSessionId String?
  recordingStatus    RecordingUploadStatus @default(PENDING)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  cohort           Cohort             @relation(fields: [cohortId], references: [id])
  makeupForSession ScheduledSession?  @relation("MakeupSession", fields: [makeupForSessionId], references: [id])
  makeupSessions   ScheduledSession[] @relation("MakeupSession")

  rescheduleRequests RescheduleRequest[]
  sessionMiss        SessionMiss?        @relation("MissedSession")
  recording          Recording?
  tutorEarning       TutorEarning?
}

model RescheduleRequest {
  id                String                   @id @default(uuid())
  sessionId         String
  requestedById     String
  requestedNewStart DateTime
  noticeHours       Decimal
  classification    RescheduleClassification
  createdAt         DateTime                 @default(now())

  session     ScheduledSession @relation(fields: [sessionId], references: [id])
  requestedBy User             @relation(fields: [requestedById], references: [id])
}

model SessionMiss {
  id              String    @id @default(uuid())
  sessionId       String    @unique
  causedBy        MissCause
  missType        MissType
  makeupSessionId String?
  createdAt       DateTime  @default(now())

  session ScheduledSession @relation("MissedSession", fields: [sessionId], references: [id])
}

model RecordingConsent {
  id                            String    @id @default(uuid())
  tutorId                       String
  studentId                     String
  tutorAcknowledgedAt           DateTime?
  studentOrParentAcknowledgedAt DateTime?
  acknowledgedByUserId          String?
  createdAt                     DateTime  @default(now())

  tutor          TutorProfile   @relation(fields: [tutorId], references: [id])
  student        StudentProfile @relation(fields: [studentId], references: [id])
  acknowledgedBy User?          @relation("ConsentAcknowledgedBy", fields: [acknowledgedByUserId], references: [id])

  @@unique([tutorId, studentId])
}

model Recording {
  id              String    @id @default(uuid())
  sessionId       String    @unique
  storageKey      String
  fileSizeBytes   Int
  encoding        String    @default("720p")
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  keepPermanently Boolean   @default(false)
  deletedAt       DateTime?

  session ScheduledSession @relation(fields: [sessionId], references: [id])
}

model LibraryMaterial {
  id                String           @id @default(uuid())
  cohortId          String
  uploadedByTutorId String
  title             String
  fileUrl           String
  fileType          MaterialFileType
  createdAt         DateTime         @default(now())
  removedAt         DateTime?

  cohort     Cohort       @relation(fields: [cohortId], references: [id])
  uploadedBy TutorProfile @relation(fields: [uploadedByTutorId], references: [id])
}

model WeeklyAssessment {
  id                 String   @id @default(uuid())
  cohortMembershipId String
  weekStartDate      DateTime
  scoreSummary       String?
  tutorFeedback      String
  submittedByTutorId String
  createdAt          DateTime @default(now())

  cohortMembership CohortMembership @relation(fields: [cohortMembershipId], references: [id])
  submittedBy      TutorProfile     @relation(fields: [submittedByTutorId], references: [id])

  @@unique([cohortMembershipId, weekStartDate])
}

// ---- PHASE 5: MESSAGING ----

enum ThreadStatus {
  ACTIVE
  ARCHIVED
  CLOSED_BY_ADMIN
}

model MessageThread {
  id         String       @id @default(uuid())
  cohortId   String       @unique
  status     ThreadStatus @default(ACTIVE)
  archivedAt DateTime?
  closedById String?
  closedAt   DateTime?
  createdAt  DateTime     @default(now())

  cohort   Cohort    @relation(fields: [cohortId], references: [id])
  closedBy User?     @relation(fields: [closedById], references: [id])
  messages Message[]
}

model Message {
  id        String   @id @default(uuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id])
  sender User          @relation(fields: [senderId], references: [id])

  @@index([threadId, createdAt])
}

// ---- PHASE 6: GAMIFICATION & ENGAGEMENT ----

enum XPReason {
  CLASS_ATTENDED
  ASSESSMENT_COMPLETED
  STREAK_MILESTONE
  CHALLENGE_COMPLETED
  BADGE_AWARDED
  OTHER
}

model XPLedgerEntry {
  id        String   @id @default(uuid())
  studentId String
  amount    Int
  reason    XPReason
  note      String?
  createdAt DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
}

enum BadgeCategory {
  STUDENT
  TUTOR
}

model Badge {
  id                  String        @id @default(uuid())
  name                String
  description         String
  category            BadgeCategory
  criteriaDescription String
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())

  studentBadges StudentBadge[]
  tutorBadges   TutorBadge[]
}

model StudentBadge {
  id        String   @id @default(uuid())
  studentId String
  badgeId   String
  earnedAt  DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id])
  badge   Badge          @relation(fields: [badgeId], references: [id])

  @@unique([studentId, badgeId])
}

model TutorBadge {
  id       String   @id @default(uuid())
  tutorId  String
  badgeId  String
  earnedAt DateTime @default(now())

  tutor TutorProfile @relation(fields: [tutorId], references: [id])
  badge Badge        @relation(fields: [badgeId], references: [id])

  @@unique([tutorId, badgeId])
}

model Streak {
  id                String    @id @default(uuid())
  studentId         String    @unique
  currentStreakDays Int       @default(0)
  longestStreakDays Int       @default(0)
  lastActivityDate  DateTime?

  student StudentProfile @relation(fields: [studentId], references: [id])
}

enum ChallengePeriod {
  WEEKLY
  MONTHLY
}

model Challenge {
  id          String          @id @default(uuid())
  title       String
  description String
  period      ChallengePeriod
  startsAt    DateTime
  endsAt      DateTime
  targetValue Int
  createdById String
  createdAt   DateTime        @default(now())

  createdBy       User                @relation(fields: [createdById], references: [id])
  progressEntries ChallengeProgress[]
}

model ChallengeProgress {
  id            String    @id @default(uuid())
  studentId     String
  challengeId   String
  progressValue Int       @default(0)
  completedAt   DateTime?

  student   StudentProfile @relation(fields: [studentId], references: [id])
  challenge Challenge      @relation(fields: [challengeId], references: [id])

  @@unique([studentId, challengeId])
}

// ── Phase 7: Payments & Earnings ────────────────────────────────────────

enum PaymentProvider {
  CHAPA
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PauseReason {
  NONPAYMENT
}

enum RefundReason {
  TUTOR_DROPOUT
  PLATFORM_OUTAGE
  FORMAT_SWITCH
  SESSION_UNDELIVERED
  ADMIN_DISPUTE_RESOLUTION
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EarningRateType {
  FULL
  REDUCED_MAKEUP
}

enum PayoutStatus {
  PENDING
  PAID
}

enum DiscountType {
  PERCENT
  FIXED_ETB
}

model Payment {
  complaints            ComplaintReport[]
  id                    String            @id @default(uuid())
  cohortMembershipId    String
  amount                Decimal
  provider              PaymentProvider   @default(CHAPA)
  providerTransactionId String?
  status                PaymentStatus     @default(PENDING)
  billingPeriodStart    DateTime
  billingPeriodEnd      DateTime
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  cohortMembership CohortMembership @relation(fields: [cohortMembershipId], references: [id])
  refunds          Refund[]
}

model PaymentPause {
  id                 String      @id @default(uuid())
  cohortMembershipId String
  startedAt          DateTime    @default(now())
  endedAt            DateTime?
  reason             PauseReason @default(NONPAYMENT)

  cohortMembership CohortMembership @relation(fields: [cohortMembershipId], references: [id])
}

model Refund {
  id                  String       @id @default(uuid())
  paymentId           String
  reason              RefundReason
  status              RefundStatus @default(PENDING)
  sessionsRemaining   Int
  totalSessionsBilled Int
  amount              Decimal
  approvedById        String?
  approvedAt          DateTime?
  rejectedById        String?
  rejectedAt          DateTime?
  rejectionReason     String?      @db.VarChar(500)
  createdAt           DateTime     @default(now())

  payment              Payment               @relation(fields: [paymentId], references: [id])
  approvedBy           User?                 @relation("RefundApprovedBy", fields: [approvedById], references: [id])
  rejectedBy           User?                 @relation("RefundRejectedBy", fields: [rejectedById], references: [id])
  formatSwitchRequests FormatSwitchRequest[]
}

model TutorEarning {
  id        String          @id @default(uuid())
  tutorId   String
  sessionId String          @unique
  amount    Decimal
  rateType  EarningRateType
  payoutId  String?
  createdAt DateTime        @default(now())

  tutor   TutorProfile     @relation(fields: [tutorId], references: [id])
  session ScheduledSession @relation(fields: [sessionId], references: [id])
  payout  Payout?          @relation(fields: [payoutId], references: [id])
  user    User?            @relation(fields: [userId], references: [id])
  userId  String?
}

model Payout {
  id          String       @id @default(uuid())
  tutorId     String
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Decimal
  status      PayoutStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime     @default(now())

  tutor    TutorProfile   @relation(fields: [tutorId], references: [id])
  earnings TutorEarning[]
  user     User?          @relation(fields: [userId], references: [id])
  userId   String?
}

model PromotionCode {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal
  validFrom     DateTime
  validTo       DateTime
  isActive      Boolean      @default(true)
  createdById   String
  createdAt     DateTime     @default(now())

  createdBy User @relation(fields: [createdById], references: [id])
}

enum ComplaintCategory {
  SESSION_ISSUE
  TUTOR_CONDUCT
  PAYMENT_ISSUE
  MESSAGE_ISSUE
  OTHER
}

enum ComplaintStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ResolutionAction {
  NO_ACTION
  WARNING_ISSUED
  REFUND_ISSUED
  TUTOR_SUSPENDED
}

model ComplaintReport {
  id               String            @id @default(uuid())
  reporterId       String
  relatedCohortId  String?
  relatedSessionId String?
  relatedPaymentId String?
  relatedThreadId  String?
  category         ComplaintCategory
  description      String
  status           ComplaintStatus   @default(OPEN)
  resolutionAction ResolutionAction?
  resolutionNotes  String?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())

  reporter   User              @relation("ComplaintReporter", fields: [reporterId], references: [id])
  resolvedBy User?             @relation("ComplaintResolver", fields: [resolvedById], references: [id])
  cohort     Cohort?           @relation(fields: [relatedCohortId], references: [id])
  session    ScheduledSession? @relation(fields: [relatedSessionId], references: [id])
  payment    Payment?          @relation(fields: [relatedPaymentId], references: [id])
}
