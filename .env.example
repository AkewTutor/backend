# ─────────────────────────────────────────────────────────────
# AKEWTutor Backend — Environment Template
#
# Copy to .env (dev) or .env.test (integration tests) and fill in
# real values. Every key listed here is declared in
# src/config/env.ts's envSchema — if you add a key to one, add it
# to the other in the same change, or the app exits at boot with
# "Invalid environment variables".
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/akewtutor_dev

# JWT (NFR-014: 30-minute access-token TTL)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30m

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Client
CLIENT_URL=http://localhost:3000

# SMS provider (Geez SMS)
GEEZ_SMS_BASE_URL=https://api.geezsms.com/api/v1
GEEZ_SMS_API_KEY=replace-with-geez-sms-api-key

# Email provider (Brevo)
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=replace-with-verified-sender-address

# Payments (Chapa) — used from Phase 5
CHAPA_API_KEY=replace-with-chapa-api-key

# Object storage (Cloudflare R2) — used from Phase 4
CLOUDFLARE_R2_ACCESS_KEY=replace-with-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=replace-with-r2-secret-key
CLOUDFLARE_R2_BUCKET=akewtutor-recordings-dev

# Seed admin (prisma/seed.ts — the only way an Admin account comes to exist)
ADMIN_SEED_EMAIL=admin@akewtutor.local
ADMIN_SEED_PASSWORD=replace-with-at-least-8-chars